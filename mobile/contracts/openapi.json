            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Offset"
          }
        },
        "type": "object",
        "required": ["items", "next_offset"],
        "title": "ItemPage"
      },
      "ItemRead": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "brand": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Brand"
          },
          "model": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Model"
          },
          "category": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Category"
          },
          "room": {
            "type": "string",
            "maxLength": 80,
            "title": "Room",
            "default": ""
          },
          "serial_number": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Serial Number"
          },
          "purchase_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Purchase Date"
          },
          "warranty_expiry": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Warranty Expiry"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "model_confirmed": {
            "type": "boolean",
            "title": "Model Confirmed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "brand",
          "model",
          "category",
          "id",
          "model_confirmed"
        ],
        "title": "ItemRead"
      },
      "JobRead": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "item_id": {
            "type": "string",
            "title": "Item Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
