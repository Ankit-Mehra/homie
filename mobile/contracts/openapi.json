            "minLength": 1,
            "title": "Name"
          },
          "brand": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Brand"
          },
          "model": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Model"
          },
          "category": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Category"
          },
          "room": {
            "type": "string",
            "maxLength": 80,
            "title": "Room",
            "default": ""
          },
          "serial_number": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Serial Number"
          },
          "purchase_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Purchase Date"
          },
          "warranty_expiry": {
            "anyOf": [
              {
                "type": "string",
